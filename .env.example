# ─────────────────────────────────────────────────────────────────────────────
# Routesy — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Development (Docker Compose): postgresql://routesy:routesy@localhost:5432/routesy
# Production (Neon): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://routesy:routesy@localhost:5432/routesy

# JWT signing secret — MUST be a long random string in production
# Generate with: openssl rand -hex 32
# The application will refuse to start if this is missing or set to 'dev-secret'
# in non-test environments.
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Server port (default: 3001)
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Frontend origin for CORS — required in production
FRONTEND_URL=http://localhost:5173

# Nominatim User-Agent (required for production — identify your deployment)
GEOCODING_USER_AGENT=Routesy/1.0 (https://routesy.app)

# ── Frontend (Vite — must use VITE_ prefix) ───────────────────────────────────

# Backend API base URL used by the frontend at runtime
# In development this is typically proxied by Vite; for production set the full URL
VITE_API_URL=http://localhost:3001

# Backend URL used only by the Vite dev-server proxy (not injected into the bundle)
# Leave unset to default to http://localhost:3001
# VITE_BACKEND_URL=http://localhost:3001
