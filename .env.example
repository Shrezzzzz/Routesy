# ─────────────────────────────────────────────────────────────────────────────
# Routesy — Environment Variables Reference
# Copy this file to packages/backend/.env for local development.
# Set these variables directly in your hosting provider for production.
# Never commit a filled-in .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local development (requires a running PostgreSQL instance):
#   postgresql://routesy:routesy@localhost:5432/routesy
# Production (Neon — include sslmode and channel_binding):
#   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://routesy:routesy@localhost:5432/routesy

# JWT signing secret — must be a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will refuse to start if this is missing or left as a placeholder
# in non-test environments.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Server port (Render sets this automatically; leave as 3001 locally)
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Frontend origin for CORS.
# Local: http://localhost:5173
# Production (Render): https://routesy-plan-your-stop.onrender.com
FRONTEND_URL=http://localhost:5173

# Nominatim User-Agent (required by Nominatim usage policy).
# Use a URL or email that identifies your deployment.
GEOCODING_USER_AGENT=Routesy/1.0 (https://github.com/Shrezzzzz/Routesy)

# ── Frontend (Vite — must use VITE_ prefix to be injected into the bundle) ───

# Backend API base URL.
# Leave empty locally — the Vite dev server proxies /api to localhost:3001.
# In production, set this to your Render backend URL before running `vite build`.
# Example: https://routesy-api.onrender.com
VITE_API_URL=

# Vite dev-server proxy target (dev only, not injected into the bundle).
# Defaults to http://localhost:3001 when unset.
# VITE_BACKEND_URL=http://localhost:3001
